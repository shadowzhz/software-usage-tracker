[Unit]
Description=Software usage evidence collector (CLI history / input method)
# GUI 使用由 GNOME 扩展 gnome-software-tracker@shadowemperor 记录，本服务只采集 CLI 和输入法证据。
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/Desktop/Project/Linux/Clearing/scripts/software-tracker.sh
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
